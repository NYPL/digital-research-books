# Use this file to run the application *inside* the docker compose network \
# against locally hosted services (DB, storage, etc...) also running inside \
# the same docker compose network (e.g. running the application in docker-compose.yml)

# MAYBE: rename env to "docker-network"

ENVIRONMENT=local
STAGE=development

DRB_API_HOST=0.0.0.0

LOG_LEVEL=debug

POSTGRES_HOST=drb_local_db
POSTGRES_READ_HOST=drb_local_db # use the read-write as read-only for local dev
POSTGRES_PORT=5432
POSTGRES_NAME=drb_test_db
POSTGRES_USER=localuser
POSTGRES_PSWD=localpsql
ADMIN_USER=postgres
ADMIN_PSWD=localpsql

VRA_API_KEY=12345

REDIS_HOST=drb_local_rs
REDIS_PORT=6379

DRB_ELASTICSEARCH_INDEX=drb_test_index
DRB_ELASTICSEARCH_SCHEME=http
DRB_ELASTICSEARCH_HOST=drb_local_es
DRB_ELASTICSEARCH_PORT=9200
DRB_ELASTICSEARCH_TIMEOUT=30
DRB_ELASTICSEARCH_USER=elastic
DRB_ELASTICSEARCH_PSWD=elastic

AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://drb-local-aws:4566

OCLC_QUERY_LIMIT=390000

API_PROXY_CORS_ALLOWED=*

READER_VERSION=v2
DEFAULT_COVER_URL=https://drb-files-qa.s3.amazonaws.com/covers/default/defaultCover.png

RECORD_PIPELINE_SQS_QUEUE=records
GRIN_INGEST_SQS_QUEUE=grin-queue

FILE_BUCKET=drb-files-local
